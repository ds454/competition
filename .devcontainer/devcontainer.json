{
    "name": "competition-service",
    "image": "mcr.microsoft.com/devcontainers/rust:2.1.5-1-bookworm",
    "initializeCommand": "docker network inspect ds454 >nul 2>&1 || docker network create ds454",
    "runArgs": [
        "--network=ds454",
        "--name=competition-service"
    ],
    "postCreateCommand": "${containerWorkspaceFolder}/.devcontainer/start.sh",
    "appPort": [
        "8084:50051"
    ],
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.1": {},
        "ghcr.io/devcontainers-extra/features/protoc:1.0.3": {
            "version": "v36.2"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "dustypomerleau.rust-syntax@0.6.1",
                "rust-lang.rust-analyzer@0.3.3105",
                "ms-azuretools.vscode-containers@2.5.2",
                "drblury.protobuf-vsc@1.6.15",
                "nicolasvuillamy.vscode-groovy-lint@4.2.1"
            ]
        }
    }
}